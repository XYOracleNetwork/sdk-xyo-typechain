{
  "name": "@xyo-network/world-typechain",
  "version": "4.2.0",
  "bugs": {
    "url": "git+https://github.com/XYOracleNetwork/sdk-xyo-typechain/issues",
    "email": "support@xyo.network"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYOracleNetwork/sdk-xyo-typechain.git"
  },
  "license": "LGPL-3.0-only",
  "author": {
    "name": "XYO Development Team",
    "email": "support@xyo.network",
    "url": "https://xyo.network"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./dist/neutral/index.mjs"
    },
    "./common": {
      "types": "./dist/neutral/common.d.ts",
      "default": "./dist/neutral/common.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types.d.ts",
    "README.md"
  ],
  "scripts": {
    "generate:sdk": "node ./scripts/generate-sdk.mjs",
    "lint-pkg": "npmPkgJsonLint .",
    "package-build": "pnpm run generate:sdk && package-build-only",
    "package-clean": "rimraf dist && rimraf src",
    "package-compile": "pnpm run generate:sdk && package-build-only",
    "package-recompile": "pnpm run package-clean && pnpm run package-compile"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@ariestools/toolchain": "^9.0.0",
    "@typechain/ethers-v6": "~0.5.1",
    "@xyo-network/world-solidity": "workspace:*",
    "glob": "~13.0.6",
    "rimraf": "~6.1.3",
    "typechain": "~8.3.2",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "docs": "dist/docs.json"
}

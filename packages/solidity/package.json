{
  "name": "@xyo-network/solidity",
  "version": "4.1.3",
  "bugs": {
    "url": "git+https://github.com/XYOracleNetwork/sdk-xyo-typechain/issues",
    "email": "support@xyo.network"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYOracleNetwork/sdk-xyo-typechain.git"
  },
  "license": "LGPL-3.0-only",
  "author": {
    "name": "XYO Development Team",
    "email": "support@xyo.network",
    "url": "https://xyo.network"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./typechain-types/index.ts"
    },
    "./artifacts/*": "./artifacts/*",
    "./contracts/*": "./contracts/*",
    "./typechain-types/*": "./typechain-types/*",
    "./package.json": "./package.json",
    "./README.md": "./README.md"
  },
  "files": [
    "contracts/**/*",
    "artifacts/**/*.json",
    "typechain-types/**/*",
    "!artifacts/**/*.dbg.json",
    "README.md"
  ],
  "scripts": {
    "deploy-ethereum": "hardhat ignition deploy ./ignition/modules/DeployXL1.ts --network ethereum --parameters ./ignition/params.ethereum.json",
    "deploy-ethereum-bridge": "hardhat ignition deploy ./ignition/modules/LiquidityPoolBridge.ts --network ethereum --parameters ./ignition/params.ethereum.json",
    "deploy-hardhat": "hardhat ignition deploy ./ignition/modules/DeployXL1.ts --network hardhat --parameters ./ignition/params.hardhat.json",
    "deploy-hardhat-bridge": "hardhat ignition deploy ./ignition/modules/LiquidityPoolBridge.ts --network hardhat --parameters ./ignition/params.hardhat.json",
    "deploy-local": "hardhat ignition deploy ./ignition/modules/DeployXL1.ts --network local --parameters ./ignition/params.local.json",
    "deploy-local-bridge": "hardhat ignition deploy ./ignition/modules/LiquidityPoolBridge.ts --network local --parameters ./ignition/params.local.json",
    "deploy-sepolia": "hardhat ignition deploy ./ignition/modules/DeployXL1.ts --network sepolia --parameters ./ignition/params.sepolia.json",
    "deploy-sepolia-bridge": "hardhat ignition deploy ./ignition/modules/LiquidityPoolBridge.ts --network sepolia --parameters ./ignition/params.sepolia.json",
    "dev": "hardhat node",
    "dev-hardhat": "hardhat ignition deploy ./ignition/modules/LocalTestChain.ts --network hardhat --parameters ./ignition/params.hardhat.json",
    "dev-local": "hardhat ignition deploy ./ignition/modules/LocalTestChain.ts --network local --parameters ./ignition/params.local.json",
    "package-build": "pnpm run package-clean && pnpm run package-compile",
    "package-clean": "hardhat clean",
    "package-compile": "hardhat compile",
    "package-coverage": "hardhat test --coverage",
    "package-lint": "echo Skipping lint...",
    "package-recompile": "pnpm run package-clean && pnpm run package-compile",
    "package-test": "hardhat test",
    "verify-ethereum": "hardhat ignition verify chain-1 --network ethereum",
    "verify-sepolia": "hardhat ignition verify chain-11155111 --network sepolia"
  },
  "devDependencies": {
    "@ariestools/toolchain": "^9.0.0",
    "@ariestools/tsconfig": "~9",
    "@nomicfoundation/hardhat-ethers": "~4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "~3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "~3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.0.0",
    "@nomicfoundation/hardhat-mocha": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "~3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "~3.0.22",
    "@openzeppelin/contracts": "~5.7.0",
    "@openzeppelin/contracts-upgradeable": "~5.7.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "~6.2.2",
    "dotenv": "~17.4.2",
    "ethers": "^6.17.0",
    "hardhat": "~3.12.0",
    "mocha": "^11.0.0",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

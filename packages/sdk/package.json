{
  "name": "@xyo-network/sdk-xyo-typechain",
  "version": "4.1.3",
  "bugs": {
    "url": "git+https://github.com/XYOracleNetwork/sdk-xyo-typechain/issues",
    "email": "support@xyo.network"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYOracleNetwork/sdk-xyo-typechain.git"
  },
  "license": "LGPL-3.0-only",
  "author": {
    "name": "XYO Development Team",
    "email": "support@xyo.network",
    "url": "https://xyo.network"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.mjs"
      },
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.mjs"
      },
      "default": "./dist/node/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm xy clean && pnpm compile",
    "compile": "pnpm -r run package-compile",
    "dev": "pnpm --filter @xyo-network/solidity dev",
    "dev-add-stake": "pnpm --filter @xyo-network/solidity exec ts-node scripts/LocalTestAddStake.ts",
    "dev-local": "pnpm --filter @xyo-network/solidity dev-local",
    "package-compile": "package-build-only"
  },
  "dependencies": {
    "@xyo-network/open-zeppelin-typechain": "workspace:*",
    "@xyo-network/typechain": "workspace:*",
    "@xyo-network/uniswap-typechain": "workspace:*",
    "@xyo-network/world-typechain": "workspace:*"
  },
  "devDependencies": {
    "@ariestools/toolchain": "^9.0.0",
    "@ariestools/tsconfig": "~9",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@xyo-network/sdk-xyo-typechain",
  "version": "4.0.10",
  "bugs": {
    "url": "git+https://github.com/XYOracleNetwork/sdk-xyo-typechain/issues",
    "email": "support@xyo.network"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYOracleNetwork/sdk-xyo-typechain.git"
  },
  "license": "LGPL-3.0-only",
  "author": {
    "name": "XYO Development Team",
    "email": "support@xyo.network",
    "url": "https://xyo.network"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node/index.mjs"
      },
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "import": "./dist/browser/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "dist/node/index.mjs",
  "types": "dist/node/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "workspaces": [
    "packages/**/*"
  ],
  "scripts": {
    "build": "yarn xy clean && yarn compile",
    "compile": "yarn workspaces foreach --all --topological-dev run package-compile",
    "dev": "yarn workspace @xyo-network/solidity dev",
    "dev-add-stake": "yarn workspace @xyo-network/solidity ts-node scripts/LocalTestAddStake.ts",
    "dev-local": "yarn workspace @xyo-network/solidity dev-local"
  },
  "dependencies": {
    "@xyo-network/open-zeppelin-typechain": "workspace:~",
    "@xyo-network/typechain": "workspace:~",
    "@xyo-network/uniswap-typechain": "workspace:~",
    "@xyo-network/world-typechain": "workspace:~"
  },
  "devDependencies": {
    "@xylabs/ts-scripts-yarn3": "~7.3.1",
    "@xylabs/tsconfig": "~7.3.1",
    "typescript": "~5.9.3"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "volta": {
    "node": "22.14.0",
    "yarn": "4.10.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

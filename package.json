{
  "name": "@xyo-network/sdk-xyo-typechain-build",
  "private": true,
  "bugs": {
    "url": "git+https://github.com/XYOracleNetwork/sdk-xyo-typechain/issues",
    "email": "support@xyo.network"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYOracleNetwork/sdk-xyo-typechain.git"
  },
  "license": "LGPL-3.0-only",
  "author": {
    "name": "XYO Development Team",
    "email": "support@xyo.network",
    "url": "https://xyo.network"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node/index.mjs"
      },
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "import": "./dist/browser/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "dist/node/index.mjs",
  "types": "dist/node/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm xy clean && pnpm compile",
    "compile": "pnpm -r --sort --if-present run package-compile",
    "dev": "pnpm --filter @xyo-network/solidity dev",
    "dev-add-stake": "pnpm --filter @xyo-network/solidity exec ts-node scripts/LocalTestAddStake.ts",
    "dev-local": "pnpm --filter @xyo-network/solidity dev-local"
  },
  "devDependencies": {
    "@ariestools/eslint-config-flat": "~9.0.2",
    "@ariestools/toolchain": "~9.0.2",
    "@ariestools/tsconfig": "~9.0.2",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@types/node": "~26.2.0",
    "@typescript-eslint/eslint-plugin": "~8.67.0",
    "@typescript-eslint/parser": "~8.67.0",
    "eslint": "~10.8.1",
    "eslint-import-resolver-typescript": "~4.4.5",
    "solc": "0.8.33",
    "typescript": "~6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=26.0.0 <27.0.0"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": ">=12.16.0 <13.0.0"
    }
  }
}
